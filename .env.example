MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=trading
MYSQL_USER=trader
MYSQL_PASSWORD=trader
MYSQL_PORT=3306
MYSQL_HOST=127.0.0.1
REDIS_PORT=6379

# market data source: public mirror, no geo issues
BINANCE_MARKET_BASE=https://data-api.binance.vision
BINANCE_TESTNET_BASE=https://testnet.binance.vision

# where parquet files live (default: <repo>/data)
# QUANT_DATA_DIR=/absolute/path/to/data

# --- Go API ---------------------------------------------------------------
# listen address; use 0.0.0.0 when the API must be reachable from outside
HOST=127.0.0.1
PORT=8080
# comma separated origins allowed to call the API (the Vue dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# set true when served over HTTPS
SESSION_COOKIE_SECURE=false

# --- auth -----------------------------------------------------------------
# signs session cookies; generate with: openssl rand -base64 32
# if empty, a random key is generated at boot and sessions reset on restart
AUTH_SECRET=
# encrypts Binance API keys at rest; must decode to exactly 32 bytes:
#   openssl rand -base64 32
CREDENTIALS_KEY=

# --- Go -> Python bridge --------------------------------------------------
# interpreter used to run `python -m quant.cli`
# QUANT_PYTHON=/absolute/path/to/quant/.venv/bin/python
# repo root containing the quant/ package; auto-detected by walking up
# QUANT_ROOT=/absolute/path/to/trading
